    },
    {
      "key": "class",
      "display_name": "Class Diagram (ক্লাস)",
      "is_diagram": true,
      "body": "```mermaid\nclassDiagram\n{{CONTENT}}\n```\n"
    },
    {
      "key": "timeline_diagram",
      "display_name": "Timeline Diagram (টাইমলাইন)",
      "is_diagram": true,
      "body": "```mermaid\ntimeline\n{{CONTENT}}\n```\n"
    },
    {
      "key": "semicircular_html",
      "display_name": "Semicircular HTML (custom)",
      "is_diagram": true,
      "body": "<div style=\"position:relative;width:100%;max-width:680px;min-height:200px;margin:20px auto;padding:16px;font-family:'Times New Roman',Times,'Kalpurush',serif;background:#f8fafc;border-radius:12px;\">\n  <div style=\"text-align:center;margin-bottom:18px;\">\n    <div style=\"display:inline-block;background:linear-gradient(145deg,#2c3e50,#1a252f);color:#f4f6f7;font-weight:700;padding:12px 24px;border-radius:14px;box-shadow:0 4px 12px rgba(44,62,80,0.25);font-size:15px;max-width:90%;word-break:break-word;\">\n      {{ROOT}}\n    </div>\n  </div>\n  <div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:8px;\">\n    {{SUBNODES}}\n  </div>\n</div>\n"
    }
  ]
}
